variable "sso_settings" {
  description = <<EOT
Map of sso_settings, attributes below
Required:
    - provider_name
Optional:
    - ldap_settings (block):
        - allow_sign_up (optional)
        - config (required, block):
            - servers (required, block):
                - attributes (optional)
                - bind_dn (optional)
                - bind_password (optional)
                - client_cert (optional)
                - client_cert_value (optional)
                - client_key (optional)
                - client_key_value (optional)
                - group_mappings (optional, block):
                    - grafana_admin (optional)
                    - group_dn (required)
                    - org_id (optional)
                    - org_role (required)
                - group_search_base_dns (optional)
                - group_search_filter (optional)
                - group_search_filter_user_attribute (optional)
                - host (required)
                - min_tls_version (optional)
                - port (optional)
                - root_ca_cert (optional)
                - root_ca_cert_value (optional)
                - search_base_dns (required)
                - search_filter (required)
                - ssl_skip_verify (optional)
                - start_tls (optional)
                - timeout (optional)
                - tls_ciphers (optional)
                - use_ssl (optional)
        - enabled (optional)
        - skip_org_role_sync (optional)
    - oauth2_settings (block):
        - allow_assign_grafana_admin (optional)
        - allow_sign_up (optional)
        - allowed_domains (optional)
        - allowed_groups (optional)
        - allowed_organizations (optional)
        - api_url (optional)
        - auth_style (optional)
        - auth_url (optional)
        - auto_login (optional)
        - client_id (required)
        - client_secret (optional)
        - custom (optional)
        - define_allowed_groups (optional)
        - define_allowed_teams_ids (optional)
        - email_attribute_name (optional)
        - email_attribute_path (optional)
        - empty_scopes (optional)
        - enabled (optional)
        - groups_attribute_path (optional)
        - id_token_attribute_name (optional)
        - login_attribute_path (optional)
        - login_prompt (optional)
        - name (optional)
        - name_attribute_path (optional)
        - org_attribute_path (optional)
        - org_mapping (optional)
        - role_attribute_path (optional)
        - role_attribute_strict (optional)
        - scopes (optional)
        - signout_redirect_url (optional)
        - skip_org_role_sync (optional)
        - team_ids (optional)
        - team_ids_attribute_path (optional)
        - teams_url (optional)
        - tls_client_ca (optional)
        - tls_client_cert (optional)
        - tls_client_key (optional)
        - tls_skip_verify_insecure (optional)
        - token_url (optional)
        - use_pkce (optional)
        - use_refresh_token (optional)
    - saml_settings (block):
        - allow_idp_initiated (optional)
        - allow_sign_up (optional)
        - allowed_organizations (optional)
        - assertion_attribute_email (optional)
        - assertion_attribute_external_uid (optional)
        - assertion_attribute_groups (optional)
        - assertion_attribute_login (optional)
        - assertion_attribute_name (optional)
        - assertion_attribute_org (optional)
        - assertion_attribute_role (optional)
        - auto_login (optional)
        - certificate (optional)
        - certificate_path (optional)
        - client_id (optional)
        - client_secret (optional)
        - enabled (optional)
        - entity_id (optional)
        - force_use_graph_api (optional)
        - idp_metadata (optional)
        - idp_metadata_path (optional)
        - idp_metadata_url (optional)
        - max_issue_delay (optional)
        - metadata_valid_duration (optional)
        - name (optional)
        - name_id_format (optional)
        - org_mapping (optional)
        - private_key (optional)
        - private_key_path (optional)
        - relay_state (optional)
        - role_values_admin (optional)
        - role_values_editor (optional)
        - role_values_grafana_admin (optional)
        - role_values_none (optional)
        - role_values_viewer (optional)
        - signature_algorithm (optional)
        - single_logout (optional)
        - skip_org_role_sync (optional)
        - token_url (optional)
EOT

  type = map(object({
    provider_name = string
    ldap_settings = optional(object({
      allow_sign_up = optional(bool)
      config = object({
        servers = list(object({
          attributes        = optional(map(string))
          bind_dn           = optional(string)
          bind_password     = optional(string)
          client_cert       = optional(string)
          client_cert_value = optional(string)
          client_key        = optional(string)
          client_key_value  = optional(string)
          group_mappings = optional(list(object({
            grafana_admin = optional(bool)
            group_dn      = string
            org_id        = optional(number)
            org_role      = string
          })))
          group_search_base_dns              = optional(list(string))
          group_search_filter                = optional(string)
          group_search_filter_user_attribute = optional(string)
          host                               = string
          min_tls_version                    = optional(string)
          port                               = optional(number)
          root_ca_cert                       = optional(string)
          root_ca_cert_value                 = optional(list(string))
          search_base_dns                    = list(string)
          search_filter                      = string
          ssl_skip_verify                    = optional(bool)
          start_tls                          = optional(bool)
          timeout                            = optional(number)
          tls_ciphers                        = optional(list(string))
          use_ssl                            = optional(bool)
        }))
      })
      enabled            = optional(bool)
      skip_org_role_sync = optional(bool)
    }))
    oauth2_settings = optional(object({
      allow_assign_grafana_admin = optional(bool)
      allow_sign_up              = optional(bool)
      allowed_domains            = optional(string)
      allowed_groups             = optional(string)
      allowed_organizations      = optional(string)
      api_url                    = optional(string)
      auth_style                 = optional(string)
      auth_url                   = optional(string)
      auto_login                 = optional(bool)
      client_id                  = string
      client_secret              = optional(string)
      custom                     = optional(map(string))
      define_allowed_groups      = optional(bool)
      define_allowed_teams_ids   = optional(bool)
      email_attribute_name       = optional(string)
      email_attribute_path       = optional(string)
      empty_scopes               = optional(bool)
      enabled                    = optional(bool)
      groups_attribute_path      = optional(string)
      id_token_attribute_name    = optional(string)
      login_attribute_path       = optional(string)
      login_prompt               = optional(string)
      name                       = optional(string)
      name_attribute_path        = optional(string)
      org_attribute_path         = optional(string)
      org_mapping                = optional(string)
      role_attribute_path        = optional(string)
      role_attribute_strict      = optional(bool)
      scopes                     = optional(string)
      signout_redirect_url       = optional(string)
      skip_org_role_sync         = optional(bool)
      team_ids                   = optional(string)
      team_ids_attribute_path    = optional(string)
      teams_url                  = optional(string)
      tls_client_ca              = optional(string)
      tls_client_cert            = optional(string)
      tls_client_key             = optional(string)
      tls_skip_verify_insecure   = optional(bool)
      token_url                  = optional(string)
      use_pkce                   = optional(bool)
      use_refresh_token          = optional(bool)
    }))
    saml_settings = optional(object({
      allow_idp_initiated              = optional(bool)
      allow_sign_up                    = optional(bool)
      allowed_organizations            = optional(string)
      assertion_attribute_email        = optional(string)
      assertion_attribute_external_uid = optional(string)
      assertion_attribute_groups       = optional(string)
      assertion_attribute_login        = optional(string)
      assertion_attribute_name         = optional(string)
      assertion_attribute_org          = optional(string)
      assertion_attribute_role         = optional(string)
      auto_login                       = optional(bool)
      certificate                      = optional(string)
      certificate_path                 = optional(string)
      client_id                        = optional(string)
      client_secret                    = optional(string)
      enabled                          = optional(bool)
      entity_id                        = optional(string)
      force_use_graph_api              = optional(bool)
      idp_metadata                     = optional(string)
      idp_metadata_path                = optional(string)
      idp_metadata_url                 = optional(string)
      max_issue_delay                  = optional(string)
      metadata_valid_duration          = optional(string)
      name                             = optional(string)
      name_id_format                   = optional(string)
      org_mapping                      = optional(string)
      private_key                      = optional(string)
      private_key_path                 = optional(string)
      relay_state                      = optional(string)
      role_values_admin                = optional(string)
      role_values_editor               = optional(string)
      role_values_grafana_admin        = optional(string)
      role_values_none                 = optional(string)
      role_values_viewer               = optional(string)
      signature_algorithm              = optional(string)
      single_logout                    = optional(bool)
      skip_org_role_sync               = optional(bool)
      token_url                        = optional(string)
    }))
  }))
  validation {
    condition = alltrue([
      for k, v in var.sso_settings : (
        v.ldap_settings == null || (length(v.ldap_settings.config.servers) >= 1)
      )
    ])
    error_message = "Each servers list must contain at least 1 items"
  }
  # Note: 1 additional provider-side validator is enforced at apply time but not mirrored as validation{} blocks here (bespoke or non-mechanically-translatable).
}

